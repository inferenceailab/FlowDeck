# Copy to .env on the homelab host and fill in real values.
# .env is excluded by .gitignore - never commit it.

# --- database -----------------------------------------------------------
POSTGRES_DB=flowdeck
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=

# Host "db" is the compose service name, not a hostname on your network.
FLOWDECK_DB_CONNECTION=Host=db;Database=flowdeck;Username=flowdeck;Password=

# --- published ports ----------------------------------------------------
API_PORT=8080
WEB_PORT=8081

# --- image selection ----------------------------------------------------
# Normally set by the CD workflow. Override to pin or roll back manually.
IMAGE_PREFIX=ghcr.io/inferenceailab/flowdeck
IMAGE_TAG=latest
