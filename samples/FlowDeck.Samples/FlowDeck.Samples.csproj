<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Never published. This exists so that a clone of FlowDeck has something to
      run; shipping it inside the deployed image would put demo definitions one
      environment-variable mistake away from a real dashboard.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\FlowDeck.Core\FlowDeck.Core.csproj" />
  </ItemGroup>

</Project>
