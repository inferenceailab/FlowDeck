<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      So tests can compile a definition the way the engine does, without
      WorkflowBuilder becoming public. Widening the API surface to suit a test
      would make an internal detail something consumers can depend on and this
      project then has to keep.
    -->
    <InternalsVisibleTo Include="FlowDeck.Core.Tests" />
  </ItemGroup>

</Project>
